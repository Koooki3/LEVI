# Modified for LEVI (2026); see NOTICE and docs/UPSTREAM.md.
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/*
!/public/urdf/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python backend
backend/.venv/
backend/__pycache__/
**/__pycache__/

# claude code local settings (personal session state, permissions, etc.)
.claude/*
# ...except repo-level skills, which are meant to be committed and shared —
# see .claude/skills/systematic-test-audit/SKILL.md
!.claude/skills/

# LEVI: private runtime, credentials, generated artifacts
.venv/
.runtime/
.state/
__pycache__/
.pytest_cache/
*.egg-info/
.env*
!.env.example
playwright-report/
test-results/
dist/

# Local lint/build caches
.ruff_cache/
.cache/

# Optional SAM3 model environment and private checkpoints
integrations/sam3/.venv/
integrations/sam3/.cache/
integrations/sam3/checkpoints/

# Optional pinned Pilot adapters
integrations/pilot/node_modules/
