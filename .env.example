# Modified for LEVI (2026); see NOTICE and docs/UPSTREAM.md.
# Optional data workspace; defaults to .state inside this repository.
# LEVI_WORKSPACE=/absolute/path/to/your/workspace
# For CLI login, use HF_HOME="$LEVI_WORKSPACE/.cache/huggingface" hf auth login.
# For backend-only Hub access without browser login (never commit real tokens):
# HF_TOKEN=hf_...
# Enable ONLY when serving via HTTPS / an HF Space iframe:
# LEVI_SECURE_COOKIES=1
# Optional OAuth application (otherwise use browser Token login):
# OAUTH_CLIENT_ID=...
# OAUTH_SCOPES=read-repos
# Optional URDF asset mirror:
# NEXT_PUBLIC_URDF_BASE_URL=https://your-model-host/robot-urdfs

# SAM3 is globally enabled by default. Set 0 only to hide the worker action.
# Core checks never import Torch, probe CUDA, download a model, or run inference.
# LEVI_SAM3_ENABLED=1
# Model mirror and file used by the worker (override only for a compatible mirror).
# LEVI_SAM3_MODEL_REPO=1038lab/sam3
# LEVI_SAM3_MODEL_FILENAME=sam3.pt
# LEVI_SAM3_MODEL_REVISION=main
# Prepare Hub video assets before a real job (set 0 only if prepared externally).
# LEVI_SAM3_DOWNLOAD_VIDEOS=1
# Worker environment on the CUDA host.
# LEVI_SAM3_WORKER_PYTHON=/absolute/path/to/LEVI/integrations/sam3/.venv/bin/python
# Optional pre-downloaded checkpoint; otherwise the UI downloads into
# $LEVI_WORKSPACE/checkpoints/sam3 and displays progress.
# LEVI_SAM3_CHECKPOINT=/absolute/path/to/sam3.pt

# Fast instance segmentation (integrations/segmentation/setup.sh; docs/SEGMENTATION.md).
# LEVI_SEG_WORKER_PYTHON=/absolute/path/to/LEVI/integrations/segmentation/.venv/bin/python
# LEVI_SEG_MODEL_DIR=/absolute/path/inside/LEVI_WORKSPACE/checkpoints/segmentation
# An flock file shared with other GPU tools; labelling and distillation queue for it:
# LEVI_GPU_LOCK_FILE=/absolute/path/to/gpu.lock

# Local models and GPU sharing (docs/OLLAMA.md).
# LEVI_CPU_ONLY=1         # no GPU watcher, no accelerator-backed inference, no SAM3
# LEVI_GPU_SHARING=allow  # turn the GPU guardian off
# LEVI_GPU_QUIET_SECONDS=300
# LEVI_LOCAL_MODEL_KEY=   # only when a local server runs with --api-key

# Training pool (docs/TRAINING_POOL.md): read-only folders it indexes, folders an
# export may be written under (default: the workspace), and the held-out lists
# (or `none`); exports are refused while LEVI_POOL_HELDOUT is unset.
# LEVI_POOL_ROOTS=/data/robot-data,/data/rollouts
# LEVI_EXPORT_ROOTS=/data/training-sets
# LEVI_POOL_HELDOUT=/data/frozen/heldout.json
# Episodes set aside for now (listed, but left out of recipes and refused by
# exports unless a recipe sets include_holdback) and independently verified
# outcomes (ranked below a human label, above the robot's key press); both
# optional, unset means none.
# LEVI_POOL_HOLDBACK=/data/lists/holdback.json
# LEVI_POOL_OUTCOMES=/data/lists/agent-verified.json

# Workspace auto-sync (levi/sync.py): new, changed and removed datasets are
# picked up while LEVI runs. Seconds between scans (0 disables):
# LEVI_SYNC_INTERVAL=5
# A changed/new dataset must stay unchanged this long before it is
# (re)built, so copies and recordings in progress are not caught half-way:
# LEVI_SYNC_SETTLE=10
# What to register automatically: all (LeRobot datasets and raw captures),
# lerobot (LeRobot only; raw captures need a manual register), off:
# LEVI_SYNC_DISCOVER=all

# Optional Agent Workbench (uv sync --locked --extra agent).
# API keys can instead be supplied through a server-memory session in the UI.
# LEVI_MODEL_API_KEY=  # set privately; never commit a real value
# Independent scope for external MCP clients; this is NOT a Hugging Face token.
# LEVI_AGENT_TOKEN=   # generate privately and share only with your own MCP client
# LEVI_AGENT_DATASETS=local/my_dataset
# LEVI_AGENT_URL=http://127.0.0.1:7861

# RECAP value model worker (integrations/recap_value/setup.sh); checkpoints
# live in $LEVI_WORKSPACE/checkpoints/recap_value/<name>/.
# LEVI_RECAP_VALUE_WORKER_PYTHON=/absolute/path/to/LEVI/integrations/recap_value/.venv/bin/python
# LEVI_RECAP_VALUE_MIN_FREE_MIB=6000
# Technical report page (/report): a folder with LEVI.md, LEVI.zh-CN.md,
# status.json and assets/, read-only; may lie outside LEVI_WORKSPACE.
# LEVI_REPORT_DIR=/absolute/path/to/report

# ---------------------------------------------------------------------------
# More settings the code reads (all optional; the value shown is the default
# or an example). INSTALL.md walks through which ones a setup needs.

# DROID test sample (docs/WORKSPACE.md#droid-test-sample): unset = download
# only on request (`levi sample fetch droid`); on = a new workspace takes it
# by itself (about 11.6 GiB); off = never start or resume one by itself.
# LEVI_DROID_SAMPLE=off
# LEVI_DROID_SAMPLE_WORKERS=4

# Training pool jobs (docs/TRAINING_POOL.md).
# LEVI_POOL_AUTO_RESUME=0            # 1: resume interrupted exports when LEVI starts
# LEVI_POOL_BATCH_EPISODES=0         # raw episodes per conversion batch (0 = auto, at least 8)
# LEVI_POOL_FREE_MARGIN_GIB=1        # free space an export leaves on its volume
# LEVI_POOL_STALL_SECONDS=300        # a job that has not moved for this long is stalled
# LEVI_POOL_PARTIAL_TTL=3            # days an interrupted export keeps its partial output
# LEVI_POOL_JOB_TTL=30               # days a finished job keeps its log
# LEVI_POOL_SSH=ssh                  # SSH client for remote push

# Local models (docs/OLLAMA.md): how long LEVI's Ollama keeps a model loaded.
# LEVI_OLLAMA_KEEP_ALIVE=2m

# Managed Pilot (docs/PILOT.md): seconds without output before a session stops.
# LEVI_PILOT_IDLE_SECONDS=600

# GPU workers: free VRAM a job needs (MiB), and when a worker is stopped.
# LEVI_SAM3_MIN_FREE_MIB=7000
# LEVI_SAM3_TIMEOUT_SECONDS=21600
# LEVI_SAM3_STALL_SECONDS=1800
# LEVI_SAM3_CHECKPOINT_DIR=/absolute/path/inside/LEVI_WORKSPACE/checkpoints/sam3
# LEVI_SEG_MIN_FREE_MIB=3000
# LEVI_SEG_DISTIL_MIN_FREE_MIB=14000
# LEVI_SEG_LIVE_MIN_FREE_MIB=2500
# LEVI_SEG_LIVE_MAX_SESSIONS=2
# LEVI_SEG_LIVE_IDLE_SECONDS=120
# LEVI_SEG_TIMEOUT_SECONDS=43200
# LEVI_SEG_STALL_SECONDS=1800
# LEVI_RECAP_VALUE_CHECKPOINT_DIR=/absolute/path/inside/LEVI_WORKSPACE/checkpoints/recap_value
# LEVI_RECAP_VALUE_DEVICE=auto       # auto, cpu, cuda or cuda:N
# LEVI_RECAP_VALUE_BATCH_SIZE=32
# LEVI_RECAP_VALUE_TIMEOUT_SECONDS=21600
# LEVI_RECAP_VALUE_STALL_SECONDS=1800

# Live annotation service (docs/LIVE.md). Its settings live in live.toml;
# these only say where to find it.
# LEVI_LIVE_WORKSPACE=/absolute/path/to/live-workspace
# LEVI_LIVE_CONFIG=/absolute/path/to/live.toml
# LEVI_LIVE_HOME=~/.levi-live
# LEVI_LIVE_AUTO_APPROVE is set by the service itself, never here.

# vLLM launcher scripts/vllm/serve.sh (docs/VLLM.md); `levi live` sets
# LEVI_VLLM_MODEL, LEVI_VLLM_SERVED_NAME and LEVI_VLLM_PID_DIR from live.toml.
# LEVI_VLLM_VENV=/absolute/path/to/LEVI/.venv-vllm
# LEVI_VLLM_CUDA_HOME=/absolute/path/to/LEVI/.venv-vllm/cuda-home
