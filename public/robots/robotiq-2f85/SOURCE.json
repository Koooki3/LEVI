    "sha256": "0227535877f04c22abddbad01fc1c60fef96a6a2dd5895f3ea55a3a2c9a9d90e",
    "conversion_excerpt": "_X0 = 0.03060114\n_DX = 0.03152616 + 0.00563134\n_DZ = -0.00376347 + 0.04718515\n\nTHETA_OPEN = 0.0\nTHETA_CLOSED = 0.7929\nJOINT_NAME = \"robotiq_85_left_knuckle_joint\"\n\n\ndef _pad_x(theta: float) -> float:\n    return _X0 + _DX * math.cos(theta) - _DZ * math.sin(theta)\n\n\nSTROKE_M = 2.0 * (_pad_x(THETA_OPEN) - _pad_x(THETA_CLOSED))\n\n\ndef theta_to_width(theta: float) -> float:\n    \"\"\"Knuckle angle (rad) -> opening width (m), clamped to the usable range.\"\"\"\n    theta = min(max(float(theta), THETA_OPEN), THETA_CLOSED)\n    return max(0.0, 2.0 * (_pad_x(theta) - _pad_x(THETA_CLOSED)))\n\n\ndef width_to_theta(width: float) -> float:\n    \"\"\"Opening width (m) -> knuckle angle (rad). Monotonic, so bisect.\"\"\"\n    width = min(max(float(width), 0.0), STROKE_M)\n    low, high = THETA_OPEN, THETA_CLOSED\n    for _ in range(64):\n        mid = 0.5 * (low + high)\n        if theta_to_width(mid) > width:\n            low = mid\n        else:\n            high = mid\n    return 0.5 * (low + high)\n"
  },
