<?xml version="1.0"?>
<!-- BSD-3-Clause derivative; see LICENSE and SOURCE.md. Standalone identity mount is not flange calibration. -->
<robot name="robotiq_2f85_preview">
  <link name="gripper_mount" />
  <link name="robotiq_85_base_link">
    <visual>
      <geometry>
        <mesh filename="robotiq_base.glb" />
      </geometry>
    </visual>
  </link>
  <link name="robotiq_85_left_knuckle_link">
    <visual>
      <geometry>
        <mesh filename="left_knuckle.glb" />
      </geometry>
    </visual>
  </link>
  <link name="robotiq_85_right_knuckle_link">
    <visual>
      <geometry>
        <mesh filename="right_knuckle.glb" />
      </geometry>
    </visual>
  </link>
  <link name="robotiq_85_left_finger_link">
    <visual>
      <geometry>
        <mesh filename="left_finger.glb" />
      </geometry>
    </visual>
  </link>
  <link name="robotiq_85_right_finger_link">
    <visual>
      <geometry>
        <mesh filename="right_finger.glb" />
      </geometry>
    </visual>
  </link>
  <link name="robotiq_85_left_inner_knuckle_link">
    <visual>
      <geometry>
        <mesh filename="left_inner_knuckle.glb" />
      </geometry>
    </visual>
  </link>
  <link name="robotiq_85_right_inner_knuckle_link">
