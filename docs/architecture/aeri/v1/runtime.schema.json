        "episode_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}\\.(?:forward|reset)\\.[0-9]{4,6}$",
          "title": "Episode Id",
          "type": "string"
        },
        "kind": {
          "const": "chunk_response",
          "title": "Kind",
          "type": "string"
        },
        "minor": {
          "maximum": 0,
          "minimum": 0,
          "title": "Minor",
          "type": "integer"
        },
        "model_version": {
          "$ref": "#/$defs/ModelVersion"
        },
        "policy_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Policy Epoch",
          "type": "integer"
        },
        "prefix_conditioning_applied": {
          "enum": [
            "none",
            "soft_guidance"
          ],
          "title": "Prefix Conditioning Applied",
          "type": "string"
        },
        "received_ns": {
          "description": "Filled by the receiving side (C's adapter) from its own clock when it collects the response, never by the server. Audit only: a deadline is judged with check_deadline on the receiver's clock, never with this field.",
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Received Ns",
          "type": "integer"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema": {
          "const": "levi.aeri.runtime.v1",
          "title": "Schema",
          "type": "string"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        },
        "valid_from_action_index": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Valid From Action Index",
          "type": "integer"
        }
      },
      "required": [
        "minor",
        "run_id",
        "emitted_wall_ns",
        "schema",
        "kind",
        "request_id",
        "episode_id",
        "policy_epoch",
