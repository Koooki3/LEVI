{
  "$defs": {
    "AdmissionRejected": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "policy_priority",
            "episode_imminent",
            "unknown_client",
            "busy",
            "no_memory",
            "deadline_infeasible",
            "cold_start_forbidden",
            "evaluation_active",
            "standby_settling",
            "shutting_down",
            "broker_unavailable"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 300,
          "title": "Detail",
          "type": "string"
        },
        "emitted_wall_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Emitted Wall Ns",
          "type": "integer"
        },
        "kind": {
          "const": "admission_rejected",
          "title": "Kind",
          "type": "string"
        },
        "legacy_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Code"
        },
        "minor": {
          "maximum": 0,
          "minimum": 0,
          "title": "Minor",
          "type": "integer"
        },
        "retry_after_ms": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Ms"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema": {
          "const": "levi.aeri.runtime.v1",
          "title": "Schema",
          "type": "string"
        },
        "workload_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Workload Id",
          "type": "string"
        }
      },
      "required": [
        "minor",
        "run_id",
        "emitted_wall_ns",
        "schema",
        "kind",
        "workload_id",
        "code",
        "retryable"
