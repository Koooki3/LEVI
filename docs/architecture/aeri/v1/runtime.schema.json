        "action_start_index": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Action Start Index",
          "type": "integer"
        },
        "clock_domain": {
          "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._-]{1,128}$",
          "title": "Clock Domain",
          "type": "string"
        },
        "committed_prefix_steps": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Committed Prefix Steps",
          "type": "integer"
        },
        "deadline": {
          "$ref": "#/$defs/Deadline"
        },
        "emitted_wall_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Emitted Wall Ns",
          "type": "integer"
        },
        "episode_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}\\.(?:forward|reset)\\.[0-9]{4,6}$",
          "title": "Episode Id",
          "type": "string"
        },
        "handle_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Handle Id",
          "type": "string"
        },
        "kind": {
          "const": "chunk_request",
          "title": "Kind",
          "type": "string"
        },
        "minor": {
          "maximum": 0,
          "minimum": 0,
          "title": "Minor",
          "type": "integer"
        },
        "obs_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Obs Ns",
          "type": "integer"
        },
        "obs_step": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Obs Step",
          "type": "integer"
        },
        "policy_epoch": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Policy Epoch",
          "type": "integer"
        },
        "prefix_conditioning": {
          "enum": [
            "none",
            "soft_guidance"
          ],
          "title": "Prefix Conditioning",
          "type": "string"
        },
        "previous_chunk_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Chunk Ref"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema": {
          "const": "levi.aeri.runtime.v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "minor",
        "run_id",
        "emitted_wall_ns",
        "schema",
        "kind",
        "request_id",
        "episode_id",
        "handle_id",
        "policy_epoch",
        "obs_step",
        "obs_ns",
        "clock_domain",
        "action_start_index",
        "committed_prefix_steps",
        "prefix_conditioning",
        "deadline"
