        "action_contract": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}@[0-9]{1,6}$",
          "title": "Action Contract",
          "type": "string"
        },
        "actions": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "clock_domain": {
          "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._-]{1,128}$",
