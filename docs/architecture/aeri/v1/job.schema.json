{
  "$defs": {
    "JobDeployment": {
      "additionalProperties": false,
      "description": "Recorded serving identity; reading a plan never loads the checkpoint.",
      "properties": {
        "checkpoint_dir": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Dir"
        },
        "checkpoint_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "config": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Config",
          "type": "string"
        }
      },
      "required": [
        "checkpoint_id",
        "config"
      ],
      "title": "JobDeployment",
      "type": "object"
    },
    "JobExperiment": {
      "additionalProperties": false,
      "properties": {
        "episodes": {
          "default": 1,
          "maximum": 100000,
          "minimum": 0,
          "title": "Episodes",
          "type": "integer"
        },
        "execution_mode": {
          "default": "shadow",
          "enum": [
            "shadow",
            "assisted",
            "autonomous"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_:-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "random_seed": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775807,
          "title": "Random Seed",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "JobExperiment",
      "type": "object"
    },
    "JobPolicies": {
      "additionalProperties": false,
      "properties": {
        "forward": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reset": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "JobPolicies",
      "type": "object"
    },
    "JobPolicy": {
      "additionalProperties": false,
      "properties": {
        "deployment": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobDeployment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_steps": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        }
      },
      "title": "JobPolicy",
      "type": "object"
    },
    "JobRecording": {
      "additionalProperties": false,
      "properties": {
        "forward_folder": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forward Folder"
        },
        "group": {
          "default": "aeri",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Group",
          "type": "string"
        },
        "reset_folder": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reset Folder"
        },
        "rollout_root": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollout Root"
        }
      },
      "title": "JobRecording",
      "type": "object"
    },
    "JobReset": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "horizon_completion": {
          "default": "wait_human",
          "enum": [
            "wait_human",
            "verify_final"
          ],
          "title": "Horizon Completion",
          "type": "string"
        },
        "human_scene_timeout_s": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Scene Timeout S"
        },
        "max_attempts": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Attempts"
        },
        "on_unknown": {
          "anyOf": [
            {
              "enum": [
                "reset",
                "wait_human"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Unknown"
        },
        "scene_check": {
          "default": "provider",
          "enum": [
            "provider",
            "operator_attested"
          ],
          "title": "Scene Check",
          "type": "string"
        },
        "settle": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobResetSettle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strategy": {
          "default": "single_reset_policy",
          "enum": [
            "single_reset_policy",
            "human_assisted",
            "subtask_loop",
            "scripted_safe_reset",
            "atomic_skill_sequence",
            "single_policy",
            "scripted_safe",
            "atomic_skills"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "title": "JobReset",
      "type": "object"
    },
    "JobResetSettle": {
      "additionalProperties": false,
      "description": "All physical stability parameters must be supplied by the operator.",
      "properties": {
        "gripper_tolerance": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Gripper Tolerance",
          "type": "number"
        },
        "max_wait_ns": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max Wait Ns",
          "type": "integer"
        },
        "position_tolerance_m": {
          "exclusiveMinimum": 0,
          "title": "Position Tolerance M",
          "type": "number"
        },
        "rotation_tolerance_rad": {
          "exclusiveMinimum": 0,
          "title": "Rotation Tolerance Rad",
          "type": "number"
        },
        "sample_interval_ns": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Sample Interval Ns",
          "type": "integer"
        },
        "stable_window_ns": {
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Stable Window Ns",
          "type": "integer"
        }
      },
      "required": [
        "sample_interval_ns",
        "stable_window_ns",
        "max_wait_ns",
        "position_tolerance_m",
        "rotation_tolerance_rad",
        "gripper_tolerance"
      ],
      "title": "JobResetSettle",
      "type": "object"
    },
    "JobSubtask": {
      "additionalProperties": false,
      "description": "The ``subtask_loop`` strategy's settings (``RunConfig`` fields of the\nsame names, ``levi/automatic/subtask_loop.py``); ignored by every other\nstrategy.",
      "properties": {
        "early_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobSubtaskEarlyCheck"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "forward_folder": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forward Folder"
        },
        "home_after_loop": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home After Loop"
        },
        "max_retries": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Retries"
        },
        "max_steps": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "max_subtasks_per_loop": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Subtasks Per Loop"
        },
        "reverse_folder": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reverse Folder"
        },
        "start_home": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Home"
        },
        "vlm": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobSubtaskVlm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vlm_alternation": {
          "anyOf": [
            {
              "enum": [
                "sleep",
                "co_resident"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlm Alternation"
        },
        "vlm_co_resident_headroom_mib": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlm Co Resident Headroom Mib"
        },
        "vlm_min_free_mem_gib": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 4096,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlm Min Free Mem Gib"
        },
        "vlm_sleep_fallback": {
          "anyOf": [
            {
              "enum": [
                "wait_human",
                "level2",
                "stay_awake"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlm Sleep Fallback"
        },
        "vlm_stay_awake_min_free_gpu_mib": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlm Stay Awake Min Free Gpu Mib"
        },
        "vlm_wake_headroom_mib": {
          "anyOf": [
            {
              "minimum": 1024,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlm Wake Headroom Mib"
        },
        "vlm_wake_min_free_gpu_mib": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vlm Wake Min Free Gpu Mib"
        }
      },
      "title": "JobSubtask",
      "type": "object"
    },
    "JobSubtaskEarlyCheck": {
      "additionalProperties": false,
      "description": "``subtask.early_check`` (``subtask_loop.EarlyCheck``, whose checks\napply too): when a running subtask stops for the VLM's done check.",
      "properties": {
        "cooldown_steps": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cooldown Steps"
        },
        "event_types": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{1,63}$",
                "type": "string"
              },
              "maxItems": 9,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Types"
        },
        "every_steps": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 40,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Every Steps"
        },
        "max_checks": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Checks"
        },
        "min_steps": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Steps"
        },
        "on_events": {
          "default": false,
          "title": "On Events",
          "type": "boolean"
        },
        "settle_steps": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settle Steps"
        }
      },
      "title": "JobSubtaskEarlyCheck",
      "type": "object"
    },
    "JobSubtaskVlm": {
      "additionalProperties": false,
      "description": "The local VLM a subtask_loop run starts, sleeps and wakes (served by\nvLLM; launch parameters as ``levi live``'s VLM manager takes them).\nDefaults: the Lynx manager's profile for the policy beside it\n(programs/lynx/VLLM-AERI-LAUNCH-20261017.md): 0.70 with 16384 tokens.",
      "properties": {
        "fallback_gpu_memory_utilization": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 0.95,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.72,
          "title": "Fallback Gpu Memory Utilization"
        },
        "gpu_memory_utilization": {
          "default": 0.7,
          "exclusiveMinimum": 0,
          "maximum": 0.95,
          "title": "Gpu Memory Utilization",
          "type": "number"
        },
        "inventory_max_tokens": {
          "anyOf": [
            {
              "maximum": 4096,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inventory Max Tokens"
        },
        "max_model_len": {
          "default": 16384,
          "maximum": 262144,
          "minimum": 1024,
          "title": "Max Model Len",
          "type": "integer"
        },
        "min_model_len": {
          "default": 16384,
          "maximum": 262144,
          "minimum": 1024,
          "title": "Min Model Len",
          "type": "integer"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "port": {
          "default": 8100,
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        },
        "prewarm": {
          "default": true,
          "title": "Prewarm",
          "type": "boolean"
        },
        "provider_mode": {
          "anyOf": [
            {
              "enum": [
                "local",
                "external"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Mode"
        },
        "request_timeout_s": {
          "default": 60,
          "maximum": 600,
          "minimum": 1,
          "title": "Request Timeout S",
          "type": "integer"
        },
        "served_name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Served Name"
        },
        "sleep_mode": {
          "default": true,
          "title": "Sleep Mode",
          "type": "boolean"
        },
        "wake_timeout_s": {
          "default": 60,
          "maximum": 600,
          "minimum": 1,
          "title": "Wake Timeout S",
          "type": "integer"
        }
      },
      "title": "JobSubtaskVlm",
      "type": "object"
    },
    "JobTask": {
      "additionalProperties": false,
      "properties": {
        "initial_state_spec": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial State Spec"
        },
        "instruction": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction"
        },
        "reset_instruction": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reset Instruction"
        },
        "success_condition": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Success Condition"
        }
      },
      "title": "JobTask",
      "type": "object"
    },
    "JobTermination": {
      "additionalProperties": false,
      "description": "``levi.automatic.termination.TerminationConfig`` as the job file\nwrites it (a key left out keeps the default there; the field list is\npinned to that class by a test).",
      "properties": {
        "allow_early_stop": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow Early Stop"
        },
        "confirmations": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmations"
        },
        "control_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Fraction"
        },
        "control_seed": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control Seed"
        },
        "cooldown_steps": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cooldown Steps"
        },
        "goal_event_types": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{1,63}$",
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goal Event Types"
        },
        "inference_mode": {
          "anyOf": [
            {
              "enum": [
                "legacy_async",
                "event_pause_judge"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Mode"
        },
        "max_requests": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Requests"
        },
        "min_steps": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Steps"
        },
        "on_unknown": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Unknown"
        },
        "physical_hold": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobResetSettle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "settle_steps": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settle Steps"
        },
        "violation_limit": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Violation Limit"
        }
      },
      "title": "JobTermination",
      "type": "object"
    }
  },
  "$id": "levi.aeri.job.v1",
